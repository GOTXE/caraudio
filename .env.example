# ============================================================
# CARAUDIO - Configuración de Variables de Entorno
# ============================================================
# Copiar este archivo a .env y ajustar los valores según tu entorno.
# El archivo .env debe estar en el RAÍZ del proyecto (/caraudio/.env)
#
# Este archivo es cargado automáticamente por el broker al iniciar.
# ============================================================

# ------------------------------------------------------------
# BROKER - Configuración del microservicio FastAPI
# ------------------------------------------------------------

# Base de datos SQLite del broker (device auth y sesiones)
# Ruta relativa desde donde se ejecuta uvicorn
CARAUDIO_BROKER_DB=broker/data/broker.db

# Secreto para generar hashes de tokens (CAMBIAR EN PRODUCCIÓN)
# Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CARAUDIO_BROKER_SECRET=change-this-secret-in-production

# Orígenes permitidos para CORS (separados por comas)
# Ejemplos:
#   - Desarrollo local: http://localhost:8080,http://127.0.0.1:8080
#   - Producción: https://tu-dominio.com
#   - Múltiples: https://tu-dominio.com,https://www.tu-dominio.com
CARAUDIO_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ------------------------------------------------------------
# FRONTEND - Servir archivos estáticos desde el broker (OPCIONAL)
# ------------------------------------------------------------
# Si quieres que el broker sirva también el frontend en / (sin nginx/Apache),
# descomenta y configura esta variable con la ruta absoluta a la carpeta web/
#
# CARAUDIO_FRONTEND_DIR=/home/user/caraudio/web
#
# Nota: En producción con reverse proxy, esta variable NO es necesaria.
# El reverse proxy sirve web/ directamente y solo proxea /api/* al broker.

# ------------------------------------------------------------
# WATCHDOG - Scripts de monitoreo (OPCIONAL)
# ------------------------------------------------------------
# Si usas los scripts de scripts/, puedes configurar estas variables:
#
# CARAUDIO_WORKDIR=/ruta/al/proyecto/caraudio
# CARAUDIO_PORT=9999
# CARAUDIO_WATCHDOG_INTERVAL=30
