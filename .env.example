# ============================================================
# CARAUDIO - Variables de entorno (scripts sin systemd)
# ============================================================
# Copiar este archivo a .env y ajustar valores.
# Los scripts scripts/start_caraudio.sh, stop_caraudio.sh y
# watchdog_caraudio.sh lo cargan automáticamente.
# ============================================================

# ------------------------------------------------------------
# MODO DE EJECUCIÓN
# ------------------------------------------------------------
# auto   -> usa broker si existe broker/app/main.py, si no static
# static -> sirve frontend con python -m http.server
# broker -> arranca FastAPI (requiere carpeta broker/)
CARAUDIO_MODE=auto

# ------------------------------------------------------------
# RUTAS BASE
# ------------------------------------------------------------
CARAUDIO_WORKDIR=/data/projects/caraudio
# En modo static, carpeta a servir por http.server (por defecto WORKDIR)
# CARAUDIO_WEB_DIR=/data/projects/caraudio
# Entorno virtual para modo broker
# CARAUDIO_VENV_DIR=/data/projects/caraudio/.venv
# Binario de python
# CARAUDIO_PYTHON_BIN=python3

# ------------------------------------------------------------
# RED / PUERTO
# ------------------------------------------------------------
CARAUDIO_HOST=0.0.0.0
CARAUDIO_PORT=9000

# ------------------------------------------------------------
# LOGS / PID
# ------------------------------------------------------------
# Se crearán:
# - $CARAUDIO_LOG_DIR/caraudio.log
# - $CARAUDIO_LOG_DIR/caraudio.pid
# - $CARAUDIO_LOG_DIR/caraudio.mode
CARAUDIO_LOG_DIR=/data/projects/caraudio/logs

# ------------------------------------------------------------
# WATCHDOG (OPCIONAL)
# ------------------------------------------------------------
CARAUDIO_WATCHDOG_INTERVAL=30

# ------------------------------------------------------------
# BROKER (SOLO SI CARAUDIO_MODE=broker O auto->broker)
# ------------------------------------------------------------
# Base de datos SQLite del broker
CARAUDIO_BROKER_DB=broker/data/broker.db

# Secreto para hashes/tokens (CAMBIAR EN PRODUCCIÓN)
# Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CARAUDIO_BROKER_SECRET=change-this-secret-in-production

# CORS permitido (separado por comas)
CARAUDIO_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Frontend servido por broker (opcional en modo broker)
# CARAUDIO_FRONTEND_DIR=/data/projects/caraudio/web
